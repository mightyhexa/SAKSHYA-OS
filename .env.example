# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing session HMAC cookies.
SESSION_SECRET="sakshya_session_secret_change_in_production_32chars"

# VAULT_MASTER_KEY: Master key for envelope encryption wrapping DEKs.
VAULT_MASTER_KEY="sakshya_vault_master_key_minimum_32_bytes_length"

# LEDGER_SEAL_SECRET: Secret key for generating HMAC-SHA256 seals on ledger blocks.
LEDGER_SEAL_SECRET="sakshya_ledger_seal_secret_secure_key"

# Optional witness integration
GITHUB_TOKEN=""
WITNESS_REPO=""
